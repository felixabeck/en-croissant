{
  "version": 1,
  "sources": [
    {
      "id": "backend",
      "root": "src-tauri/src",
      "include": ["src-tauri/src/**/*.rs"],
      "exclude": [
        {
          "pattern": "src-tauri/src/engine/mod.rs",
          "reason": "Module declarations only; no executable statements exist to instrument."
        },
        {
          "pattern": "src-tauri/src/infra/mod.rs",
          "reason": "Module declarations only; no executable statements exist to instrument."
        },
        {
          "pattern": "src-tauri/src/db/schema.rs",
          "reason": "Diesel table declarations generate types only; no application statements exist to exercise."
        }
      ]
    }
  ],
  "areas": [
    {
      "id": "app-infrastructure",
      "source": "backend",
      "minimumCoverage": { "lines": 66, "functions": 47, "branches": 36 },
      "paths": ["src-tauri/src/main.rs", "src-tauri/src/error.rs", "src-tauri/src/infra/**"]
    },
    {
      "id": "filesystem-native-boundaries",
      "source": "backend",
      "minimumCoverage": { "lines": 50, "functions": 38, "branches": 36 },
      "paths": [
        "src-tauri/src/file_workspace.rs",
        "src-tauri/src/fs.rs",
        "src-tauri/src/lexer.rs",
        "src-tauri/src/pgn.rs",
        "src-tauri/src/sound.rs"
      ]
    },
    {
      "id": "oauth-credentials",
      "source": "backend",
      "minimumCoverage": { "lines": 68, "functions": 61, "branches": 53 },
      "paths": [
        "src-tauri/src/credentials.rs",
        "src-tauri/src/chesscom.rs",
        "src-tauri/src/oauth.rs",
        "src-tauri/src/lichess.rs"
      ]
    },
    {
      "id": "database-search",
      "source": "backend",
      "minimumCoverage": { "lines": 65, "functions": 54, "branches": 65 },
      "paths": ["src-tauri/src/db/**"]
    },
    {
      "id": "engine-game-chess",
      "source": "backend",
      "minimumCoverage": { "lines": 48, "functions": 54, "branches": 55 },
      "paths": ["src-tauri/src/chess.rs", "src-tauri/src/game.rs", "src-tauri/src/engine/**"]
    },
    {
      "id": "auxiliary-domain-services",
      "source": "backend",
      "minimumCoverage": { "lines": 55, "functions": 41, "branches": 79 },
      "paths": ["src-tauri/src/opening.rs", "src-tauri/src/progress.rs", "src-tauri/src/puzzle.rs"]
    }
  ]
}
