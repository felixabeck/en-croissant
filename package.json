{
  "name": "en-croissant",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start-vite": "vite",
    "build-vite": "tsgo --noEmit && vite build",
    "build": "tauri build --no-bundle",
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri": "tauri",
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin en-croissant -- --export-bindings-only",
    "bindings:check": "node scripts/check-bindings.mjs",
    "skills:check": "node scripts/check-skill-bridges.mjs",
    "skills:bridges:test": "node --test scripts/check-skill-bridges-tests.mjs",
    "gates:routing:check": "node scripts/check-gate-routing.mjs",
    "gates:routing:test": "node --test scripts/check-gate-routing-tests.mjs",
    "gate:ensure": "node scripts/gate-receipt.mjs ensure",
    "gate:run": "node scripts/gate-receipt.mjs run",
    "gate:check": "node scripts/gate-receipt.mjs check",
    "gates:receipt:test": "node --test scripts/gate-receipt-tests.mjs",
    "workflows:check": "node scripts/check-workflow-permissions.mjs && node scripts/check-workflow-permissions.mjs --actionlint",
    "workflows:permissions:test": "node --test scripts/check-workflow-permissions-tests.mjs",
    "tools:parity:check": "node scripts/check-tool-version-parity.mjs",
    "tools:parity:test": "node --test scripts/check-tool-version-parity-tests.mjs",
    "hooks:check": "bash -n .claude/hooks/*.sh && pnpm dlx shellcheck@4.1.0 .claude/hooks/*.sh && pnpm hooks:payload:test",
    "hooks:payload:test": "node --test scripts/hook-block-env-files-tests.mjs",
    "tauri:boundary:check": "node scripts/check-tauri-command-boundary.mjs",
    "rust:surface:check": "node scripts/check-rust-release-surface.mjs",
    "ui:boundary:check": "node scripts/check-ui-boundaries.mjs",
    "ui:boundary:report:test": "node --test scripts/check-ui-boundaries-tests.mjs",
    "format": "oxfmt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "coverage:frontend:check": "node scripts/coverage-report.mjs --config coverage-areas.json --baseline coverage-baselines.json --lcov coverage/lcov.info",
    "coverage:baseline:frontend": "node scripts/coverage-report.mjs --config coverage-areas.json --baseline coverage-baselines.json --lcov coverage/lcov.info --write-baseline",
    "test:coverage:backend": "node scripts/ensure-output-directory.mjs backend-coverage && node scripts/rust-branch-coverage.mjs",
    "coverage:backend:check": "node scripts/coverage-report.mjs --config backend-coverage-areas.json --baseline backend-coverage-baselines.json --lcov backend-coverage/lcov.info",
    "coverage:baseline:backend": "node scripts/coverage-report.mjs --config backend-coverage-areas.json --baseline backend-coverage-baselines.json --lcov backend-coverage/lcov.info --write-baseline",
    "coverage:report:test": "node --test scripts/coverage-report-tests.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bundle:report:test": "node --test scripts/check-bundle-budget-tests.mjs",
    "mutation:frontend": "node scripts/run-frontend-mutation.mjs",
    "mutation:backend": "node scripts/run-backend-mutation.mjs",
    "mutation:runner:test": "node --test scripts/run-backend-mutation-tests.mjs",
    "mutation:guard:check": "node scripts/run-backend-mutation.mjs --check-guard",
    "findings:test": "python3 -B scripts/findings-atomic-write-tests.py",
    "findings:kit:check": "bash \"$HOME/Projekte/agent-kit/bin/kit\" sync --check .",
    "mutation": "pnpm mutation:frontend && pnpm mutation:backend",
    "lint": "tsgo --noEmit && oxlint --deny-warnings",
    "lint:ci": "tsgo --noEmit && oxfmt --check && oxlint --deny-warnings --format=github && i18next-cli extract --ci && pnpm i18n:jsx && pnpm i18n:check",
    "lint:fix": "oxlint --fix",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "i18n:jsx": "node scripts/check-untranslated-jsx.mjs",
    "i18n:check": "node scripts/i18n-completeness.mjs",
    "i18n:types": "i18next-cli types",
    "i18n:sync": "i18next-cli sync",
    "verify:app": "node scripts/verify-app.mjs",
    "test:e2e": "playwright test",
    "test:e2e:container": "node scripts/run-e2e-container.mjs",
    "test:e2e:update": "node scripts/run-e2e-container.mjs --update-snapshots"
  },
  "dependencies": {
    "@badrap/result": "^0.2.13",
    "@hello-pangea/dnd": "^18.0.1",
    "@lichess-org/chessground": "^10.1.1",
    "@mantine/charts": "^8.3.14",
    "@mantine/core": "^8.3.14",
    "@mantine/dates": "^8.3.14",
    "@mantine/form": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@mantine/notifications": "^8.3.14",
    "@mantine/tiptap": "^8.3.14",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-router": "^1.161.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-window-state": "~2.4.1",
    "@tiptap/extension-link": "3.20.0",
    "@tiptap/extension-placeholder": "3.20.0",
    "@tiptap/extension-underline": "3.20.0",
    "@tiptap/markdown": "^3.20.0",
    "@tiptap/pm": "3.20.0",
    "@tiptap/react": "3.20.0",
    "@tiptap/starter-kit": "3.20.0",
    "@vitejs/plugin-react": "^6.0.0",
    "chessops": "^0.14.0",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.10",
    "dom-to-image": "^2.6.0",
    "fast-deep-equal": "^3.1.3",
    "fuse.js": "^7.0.0",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.4",
    "jotai": "^2.18.1",
    "lz-string": "^1.5.0",
    "mantine-contextmenu": "^8.3.13",
    "mantine-datatable": "^8.3.13",
    "mantine-flagpack": "^4.1.1",
    "posthog-js": "^1.342.1",
    "proxy-memoize": "^3.0.1",
    "react": "^19.2.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-draggable": "^4.5.0",
    "react-hotkeys-hook": "^4.5.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-mosaic-component": "^6.1.1",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.0",
    "swr": "^2.4.0",
    "ts-fsrs": "^3.5.1",
    "ts-pattern": "^5.0.8",
    "vite": "^8.0.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "^7.29.0",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "^0.2.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tanstack/router-plugin": "^1.161.1",
    "@tauri-apps/cli": "2.10.0",
    "@types/babel__core": "^7.20.5",
    "@types/dom-to-image": "^2.6.7",
    "@types/lodash": "^4.17.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260306.1",
    "@vitest/coverage-v8": "4.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "i18next-cli": "^1.42.12",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
