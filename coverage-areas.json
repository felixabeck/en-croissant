{
  "version": 1,
  "sources": [
    {
      "id": "frontend",
      "root": "src",
      "include": ["src/**/*.ts", "src/**/*.tsx"],
      "exclude": [
        { "pattern": "src/**/*.test.ts", "reason": "Vitest test files are not production code." },
        { "pattern": "src/**/*.test.tsx", "reason": "Vitest test files are not production code." },
        { "pattern": "src/**/*.spec.ts", "reason": "Vitest spec files are not production code." },
        { "pattern": "src/**/*.spec.tsx", "reason": "Vitest spec files are not production code." },
        {
          "pattern": "src/**/tests/**",
          "reason": "Vitest test directories are not production code."
        },
        {
          "pattern": "src/bindings/generated.ts",
          "reason": "Generated from the Rust command/event schema; checked by bindings:check."
        },
        { "pattern": "src/routeTree.gen.ts", "reason": "Generated by the TanStack router plugin." },
        {
          "pattern": "src/vite-env.d.ts",
          "reason": "Vite ambient type declarations with no runtime code."
        }
      ]
    }
  ],
  "areas": [
    {
      "id": "application-bootstrap",
      "source": "frontend",
      "minimumCoverage": { "lines": 25, "functions": 20, "branches": 15 },
      "paths": ["src/App.tsx", "src/i18n.ts", "src/index.tsx", "src/platform/analytics.ts"]
    },
    {
      "id": "boards-game-analysis",
      "source": "frontend",
      "minimumCoverage": { "lines": 5, "functions": 7, "branches": 3 },
      "paths": [
        "src/components/boards/**",
        "src/components/common/Comment.tsx",
        "src/components/common/CompleteMoveCell.tsx",
        "src/components/common/DetachedEval.tsx",
        "src/components/common/EvalChart.tsx",
        "src/components/common/GameInfo.tsx",
        "src/components/common/GameNotation.tsx",
        "src/components/common/MoveCell.tsx",
        "src/components/common/MoveControls.tsx",
        "src/components/common/OpeningName.tsx",
        "src/components/common/Piece.tsx",
        "src/components/common/ShowMaterial.tsx",
        "src/components/common/TreeStateContext.tsx",
        "src/components/panels/analysis/**",
        "src/components/panels/annotation/**",
        "src/components/panels/practice/**",
        "src/utils/annotation.ts",
        "src/utils/chess.ts",
        "src/utils/chessops.ts",
        "src/utils/clock.ts",
        "src/utils/misc.ts",
        "src/utils/phase.ts",
        "src/utils/repertoire.ts",
        "src/utils/score.ts",
        "src/utils/timeControl.ts",
        "src/utils/treeReducer.ts"
      ]
    },
    {
      "id": "databases-files",
      "source": "frontend",
      "minimumCoverage": { "lines": 10, "functions": 15, "branches": 7 },
      "paths": [
        "src/components/databases/**",
        "src/components/files/**",
        "src/components/panels/database/**",
        "src/utils/db.ts",
        "src/utils/directories.ts",
        "src/utils/files.ts"
      ]
    },
    {
      "id": "accounts-remote",
      "source": "frontend",
      "minimumCoverage": { "lines": 15, "functions": 12, "branches": 10 },
      "paths": [
        "src/components/common/AccountCards.tsx",
        "src/components/home/**",
        "src/utils/chess.com/**",
        "src/utils/http.ts",
        "src/utils/lichess/**",
        "src/utils/session.ts"
      ]
    },
    {
      "id": "puzzles-engines",
      "source": "frontend",
      "minimumCoverage": { "lines": 5, "functions": 6, "branches": 1.5 },
      "paths": [
        "src/components/common/ChallengeHistory.tsx",
        "src/components/common/EngineLogsView.tsx",
        "src/components/common/GoModeInput.tsx",
        "src/components/common/TimeInput.tsx",
        "src/components/engines/**",
        "src/components/puzzles/**",
        "src/utils/chessdb/**",
        "src/utils/engines.ts",
        "src/utils/puzzles.ts"
      ]
    },
    {
      "id": "settings",
      "source": "frontend",
      "minimumCoverage": { "lines": 2, "functions": 3, "branches": 1 },
      "paths": ["src/components/settings/**", "src/styles/**"]
    },
    {
      "id": "shared-shell-ui",
      "source": "frontend",
      "minimumCoverage": { "lines": 10, "functions": 7, "branches": 7 },
      "paths": [
        "src/components/About.tsx",
        "src/components/ErrorComponent.tsx",
        "src/components/Sidebar.tsx",
        "src/components/TopBar.tsx",
        "src/components/common/ConfirmModal.tsx",
        "src/components/common/AppModal.tsx",
        "src/components/common/FileInput.tsx",
        "src/components/common/GenericCard.tsx",
        "src/components/common/InlineInput.tsx",
        "src/components/common/IconAction.tsx",
        "src/components/common/LocalImage.tsx",
        "src/components/common/ProgressButton.tsx",
        "src/components/common/ToggleButtonGroup.tsx",
        "src/components/icons/**",
        "src/utils/format.ts",
        "src/utils/unwrap.tsx"
      ]
    },
    {
      "id": "state-persistence",
      "source": "frontend",
      "minimumCoverage": { "lines": 70, "functions": 60, "branches": 50 },
      "paths": ["src/hooks/**", "src/state/**"]
    },
    {
      "id": "tabs-routing",
      "source": "frontend",
      "minimumCoverage": { "lines": 10, "functions": 4, "branches": 10 },
      "paths": [
        "src/components/panels/info/**",
        "src/components/tabs/**",
        "src/routes/**",
        "src/utils/tabs.ts"
      ]
    },
    {
      "id": "tauri-ipc-platform",
      "source": "frontend",
      "minimumCoverage": { "lines": 70, "functions": 60, "branches": 60 },
      "paths": [
        "src/bindings/index.ts",
        "src/chessground/**",
        "src/components/common/OpenFolderButton.tsx",
        "src/platform/errors.ts",
        "src/platform/http.ts",
        "src/platform/native.ts",
        "src/platform/operation.ts",
        "src/platform/tauri.ts",
        "src/platform/useTauriListener.ts",
        "src/utils/pathCapabilities.ts",
        "src/utils/sound.ts"
      ]
    }
  ]
}
