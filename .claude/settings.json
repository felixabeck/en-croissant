{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Write", "Edit", "MultiEdit", "Bash"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Bash(pnpm coverage:baseline:frontend*)",
      "Bash(pnpm coverage:baseline:backend*)",
      "Bash(pnpm run coverage:baseline:frontend*)",
      "Bash(pnpm run coverage:baseline:backend*)",
      "Bash(*coverage-report.mjs*--write-baseline*)",
      "Bash(*playwright*--update-snapshots*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
