# Build temporaries in the repository root. Both are empty at the moment and therefore
# invisible to git (git does not track empty directories) — they become untracked as soon
# as they hold anything. /target/ is additionally a safety net: a cargo invoked from the
# repository root instead of from src-tauri/ creates a second target directory there, which
# src-tauri/.gitignore does not cover.
/target/
/.tanstack/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

src-tauri/gen/

# Findings ledger runtime state. `tasks/findings.md` and `tasks/decisions.md` are
# tracked; everything the spool, the locks and the answer channel create is not.
tasks/findings-inbox/
tasks/findings-inbox.claim/
tasks/findings-inbox.md
tasks/findings-inbox.md.claim-*
tasks/findings-inbox.publish.lock
tasks/findings-inbox.receipts/
tasks/findings-answers/
tasks/findings-answers.claim/
tasks/findings-answers.publish.lock
tasks/findings.md.lock
tasks/findings.md.lock/
tasks/decisions.md.lock
tasks/decisions.md.lock/
tasks/.decisions-announced.json
tasks/.decisions-announced.json.lock
tasks/*.tmp-*
tasks/*.candidate-*
tasks/.*.part

# `build` run artefacts. Plans are a run artefact, not a deliverable — the permanent
# trail is the commit messages and `tasks/findings.md`.
tasks/plans/
